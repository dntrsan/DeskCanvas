<Window x:Class="DeskCanvas.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskCanvas"
        Width="900"
        Height="660"
        MinWidth="780"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource LabelBrush}"
        FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!--  A grouped-settings row: label on the left, control on the right, hairline below.  -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="LastRow" TargetType="Border" BasedOn="{StaticResource Row}">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!--  Rounded container that holds a run of rows.  -->
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  ================= Header =================  -->
        <Grid Margin="28,22,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleText}" Text="DeskCanvas"/>
                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="0,3,0,0"
                           Text="画像・GIF・時計・再生中・システム情報を、デスクトップへ。"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,8,0" Click="Add_Click" Content="画像 / GIF"/>
                <Button Margin="0,0,8,0" Click="BuiltIn_Click" Content="ウィジェット"/>
                <Button x:Name="HideAllButton"
                        Margin="0,0,8,0"
                        Click="HideAll_Click"
                        Content="すべて隠す"/>
                <Button x:Name="EditModeButton"
                        MinWidth="132"
                        Style="{StaticResource AccentButton}"
                        Click="EditMode_Click"
                        Content="編集モード"/>
            </StackPanel>
        </Grid>

        <!--  ================= Body =================  -->
        <Grid Grid.Row="1" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--  Sidebar  -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionText}"
                               Margin="18,16,18,8"
                               Text="配置中の項目"/>
                    <ListBox x:Name="ItemsList"
                             Grid.Row="1"
                             Margin="8,0,8,10"
                             SelectionChanged="ItemsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding KindLabel}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Opacity=".72"/>
                                    </StackPanel>
                                    <!--  Lock indicator only; toggling happens in the detail pane.  -->
                                    <Path Grid.Column="1"
                                          Width="11"
                                          Height="13"
                                          Margin="8,0,2,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Opacity=".72"
                                          Stroke="{StaticResource LabelBrush}"
                                          StrokeThickness="1.3"
                                          StrokeLineJoin="Round"
                                          ToolTip="個別ロック中"
                                          Data="M 4.5,7.5 H 11.5 V 13.5 H 4.5 Z M 6.2,7.5 V 5.6 A 1.8,1.8 0 0 1 9.8,5.6 V 7.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!--  Detail pane  -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    SnapsToDevicePixels="True">
                <Grid>
                    <TextBlock x:Name="EmptyMessage"
                               Margin="40"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               LineHeight="21"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="左の一覧から項目を選ぶか、&#x0a;ここへ画像 / GIF をドロップしてください。"/>

                    <!--  Inset vertically so scrolling content never crosses the panel's rounded corners.  -->
                    <ScrollViewer x:Name="EditorScroll"
                                  Margin="0,14,4,14"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EditorPanel" Margin="24,8,16,8" Visibility="Collapsed">
                            <TextBlock x:Name="SelectedName"
                                       Style="{StaticResource HeadlineText}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Style="{StaticResource SectionText}" Margin="0,22,0,0" Text="表示"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="不透明度"/>
                                            <Slider x:Name="OpacitySlider"
                                                    Grid.Column="1"
                                                    Margin="20,0,16,0"
                                                    VerticalAlignment="Center"
                                                    Minimum="5"
                                                    Maximum="100"
                                                    ValueChanged="OpacitySlider_ValueChanged"/>
                                            <TextBlock x:Name="OpacityValue"
                                                       Grid.Column="2"
                                                       Style="{StaticResource RowValue}"
                                                       MinWidth="42"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="角度"/>
                                            <Slider x:Name="RotationSlider"
                                                    Grid.Column="1"
                                                    Margin="20,0,16,0"
                                                    VerticalAlignment="Center"
                                                    Minimum="-180"
                                                    Maximum="180"
                                                    ValueChanged="RotationSlider_ValueChanged"/>
                                            <TextBlock x:Name="RotationValue"
                                                       Grid.Column="2"
                                                       Style="{StaticResource RowValue}"
                                                       MinWidth="52"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource LastRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="装飾"/>
                                            <ComboBox x:Name="DecorationCombo"
                                                      Grid.Column="1"
                                                      Width="180"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="DecorationCombo_SelectionChanged">
                                                <ComboBoxItem Content="なし" Tag="None"/>
                                                <ComboBoxItem Content="白いふち" Tag="WhiteOutline"/>
                                                <ComboBoxItem Content="外枠" Tag="OuterFrame"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="AppearanceSectionLabel"
                                       Style="{StaticResource SectionText}"
                                       Visibility="Collapsed"
                                       Text="外観"/>
                            <Border x:Name="AppearanceGroup"
                                    Style="{StaticResource Group}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <Border x:Name="SurfaceRow" Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="サーフェス"/>
                                            <ComboBox x:Name="SurfaceCombo"
                                                      Grid.Column="1"
                                                      Width="180"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="SurfaceCombo_SelectionChanged"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="MonitorStyleRow" Style="{StaticResource LastRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="スタイル"/>
                                            <ComboBox x:Name="MonitorStyleCombo"
                                                      Grid.Column="1"
                                                      Width="180"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="MonitorStyleCombo_SelectionChanged"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionText}" Text="動作"/>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowLabel}" Text="個別ロック"/>
                                                <TextBlock Style="{StaticResource CaptionText}"
                                                           Margin="0,1,0,0"
                                                           Opacity=".8"
                                                           Text="編集モードでも動かせなくなります"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ItemLockCheck"
                                                      Grid.Column="1"
                                                      Margin="16,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Click="ItemLockCheck_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="TemporaryHideRow" Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="一時的に隠す"/>
                                            <CheckBox x:Name="TemporaryHideCheck"
                                                      Grid.Column="1"
                                                      Margin="16,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Click="TemporaryHideCheck_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="FlipRow" Style="{StaticResource LastRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="左右反転"/>
                                            <CheckBox x:Name="FlipCheck"
                                                      Grid.Column="1"
                                                      Margin="16,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Click="FlipCheck_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionText}" Text="重なり順"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Margin="0,0,8,0" Click="BringFront_Click" Content="前面へ"/>
                                <Button Margin="0,0,8,0" Click="SendBack_Click" Content="背面へ"/>
                                <Button Click="ResetRotation_Click" Content="角度を戻す"/>
                            </StackPanel>

                            <Border Height="1"
                                    Margin="0,24,0,20"
                                    Background="{StaticResource SeparatorBrush}"/>

                            <Button HorizontalAlignment="Left"
                                    Style="{StaticResource DestructiveButton}"
                                    Click="Delete_Click"
                                    Content="この項目を削除"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  ================= Footer =================  -->
        <Grid Grid.Row="2" Margin="28,18,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Text="ロック中 — Ctrl + Alt + L で編集モードを切り替え"/>
            <CheckBox x:Name="StartupCheck"
                      Grid.Column="1"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Click="StartupCheck_Click"
                      Content="サインイン時に起動"/>
        </Grid>
    </Grid>
</Window>
