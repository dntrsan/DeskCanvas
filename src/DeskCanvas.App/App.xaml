<Application x:Class="DeskCanvas.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#8C7CFF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181922"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8A9B7"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#2C2D3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#424454"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Background" Value="#242630"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#414352"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Application.Resources>
</Application>
