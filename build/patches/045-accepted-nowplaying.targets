<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildProjectDirectory)\Services\NowPlayingService.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v12\App\Services\NowPlayingService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v12\App\Services\NowPlayingService.Accepted.cs" Link="Services\NowPlayingService.cs" />
  </ItemGroup>
</Project>
