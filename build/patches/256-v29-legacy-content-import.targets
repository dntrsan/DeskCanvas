  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v29\Tests\V29LegacyImportContractTests.cs" Link="V29LegacyImportContractTests.cs" />
  </ItemGroup>
</Project>
