<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Version>1.2.0-beta.16</Version>
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix>beta.16</VersionSuffix>
    <PackageVersion>1.2.0-beta.16</PackageVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.16</FileVersion>
    <InformationalVersion>1.2.0-beta.16</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <PropertyGroup>
    <DeskCanvasInstallerSource>$(MSBuildThisFileDirectory)..\..\installer\DeskCanvas.v43.Beta16.GlassLens.SingleFile.iss</DeskCanvasInstallerSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v42\App\ApplicationVersion.V42Beta15.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v43\App\ApplicationVersion.V43Beta16.cs" Link="ApplicationVersion.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v42\Tests\V42Beta15ContractTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v43\Tests\V43Beta16ContractTests.cs" Link="V43Beta16ContractTests.cs" />
  </ItemGroup>
</Project>
