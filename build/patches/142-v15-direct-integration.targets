    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v15\App\Windows\MediaWindow.DpiFixed.cs" Link="Windows\MediaWindow.Fixed.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v15\App\Windows\LiveWidgetV15Behavior.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v15\App\Windows\LiveWidgetV15Behavior.Accepted.cs" />
  </ItemGroup>
</Project>
