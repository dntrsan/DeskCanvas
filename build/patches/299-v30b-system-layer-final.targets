<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Core'">
    <Compile Remove="$(MSBuildProjectDirectory)\LayoutRepository.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v30b\Core\LayoutRepository.V30Layers.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v30b\Core\LayoutRepository.V30Layers.Final.cs" Link="LayoutRepository.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v30b\Core\LayerOrderMath.cs" Link="LayerOrderMath.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v20\App\Windows\SystemMonitor.V20Adaptive.Accepted3.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v30\App\SystemMonitor.V30Responsive.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v30b\App\Windows\SystemMonitor.V30Responsive.Final2.cs" Link="Windows\SystemMonitor.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v30b\Tests\V30SystemLayerContractTests.cs" Link="V30SystemLayerContractTests.cs" />
  </ItemGroup>
</Project>
