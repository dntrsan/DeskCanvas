<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Version>1.2.0-beta.4</Version>
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix>beta.4</VersionSuffix>
    <PackageVersion>1.2.0-beta.4</PackageVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.4</FileVersion>
    <InformationalVersion>1.2.0-beta.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v24\App\ApplicationVersion.V24Beta3.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v31\App\ApplicationVersion.V31Beta4.cs" Link="ApplicationVersion.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v24\Tests\V24Beta3VersionContractTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v31\Tests\V31Beta4VersionContractTests.cs" Link="V31Beta4VersionContractTests.cs" />
  </ItemGroup>
</Project>
