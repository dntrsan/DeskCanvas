    <Compile Remove="$(MSBuildProjectDirectory)\Windows\MainWindow.ThemeEditor.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v19\App\Windows\MainWindow.ThemeAndNowPlayingOptions.V19.Accepted.cs" Link="Windows\MainWindow.ThemeEditor.cs" />
  </ItemGroup>
</Project>
