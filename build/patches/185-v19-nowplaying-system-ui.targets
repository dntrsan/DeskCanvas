<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v17\App\Windows\LiveItemContent.ActivationFallback.Clean.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v18\App\Windows\LiveItemContent.V18.Accepted.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v18\App\Windows\SystemMonitor.V18.Accepted.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v19\App\Windows\LiveItemContent.V19.Accepted.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v19\App\Windows\LiveItemContent.V19.Accepted2.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v19\App\Windows\LiveItemContent.V19.Accepted3.cs" Link="Windows\LiveItemContent.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v19\App\Windows\SystemMonitor.V19.RingAccepted.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v19\App\Windows\SystemMonitor.V19.RingAccepted2.cs" Link="Windows\SystemMonitor.V19.cs" />
    <Compile Remove="$(MSBuildProjectDirectory)\Windows\BuiltInContentPicker.cs" />
