<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Version>1.2.0-beta.3</Version>
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix>beta.3</VersionSuffix>
    <PackageVersion>1.2.0-beta.3</PackageVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.3</FileVersion>
    <InformationalVersion>1.2.0-beta.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v23\App\ApplicationVersion.V23Beta2.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v24\App\ApplicationVersion.V24Beta3.cs" Link="ApplicationVersion.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v23\Tests\V23Beta2VersionContractTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v24\Tests\V24Beta3VersionContractTests.cs" Link="V24Beta3VersionContractTests.cs" />
  </ItemGroup>
</Project>
