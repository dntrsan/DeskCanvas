<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Core'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v19\Core\Models.V19Options.Accepted.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v20\Core\Models.V20ProgressChoices.Accepted.cs" Link="Models.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v19\App\Windows\BuiltInContentPicker.V19Options.Accepted2.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v20\App\Windows\BuiltInContentPicker.V20ProgressChoices.Accepted.cs" Link="Windows\BuiltInContentPicker.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v19\App\Windows\MainWindow.ThemeAndNowPlayingOptions.V19.Accepted4.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v20\App\Windows\MainWindow.ThemeAndNowPlayingOptions.V20ProgressChoices.Accepted.cs" Link="Windows\MainWindow.ThemeEditor.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v20\Tests\V20ProgressStyleMigrationTests.cs" Link="V20ProgressStyleMigrationTests.cs" />
  </ItemGroup>
</Project>
