<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Version>1.2.0-beta.5</Version>
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix>beta.5</VersionSuffix>
    <PackageVersion>1.2.0-beta.5</PackageVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.5</FileVersion>
    <InformationalVersion>1.2.0-beta.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v31\App\ApplicationVersion.V31Beta4.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v32\App\ApplicationVersion.V32Beta5.cs" Link="ApplicationVersion.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v31\Tests\V31Beta4VersionContractTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v32\Tests\V32Beta5ContractTests.cs" Link="V32Beta5ContractTests.cs" />
  </ItemGroup>
</Project>
