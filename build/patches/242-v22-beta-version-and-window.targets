<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Version>1.2.0-beta.1</Version>
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <PackageVersion>1.2.0-beta.1</PackageVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0-beta.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v22\App\ApplicationVersion.V22Beta.cs" Link="ApplicationVersion.cs" />
    <Page Remove="$(MSBuildThisFileDirectory)..\overrides\v14\App\Windows\MainWindow.xaml" />
    <Page Include="$(MSBuildThisFileDirectory)..\overrides\v22\App\Windows\MainWindow.V22Beta.xaml" Link="Windows\MainWindow.xaml" />
  </ItemGroup>
</Project>
