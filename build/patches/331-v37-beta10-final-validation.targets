<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Version>1.2.0-beta.10</Version>
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix>beta.10</VersionSuffix>
    <PackageVersion>1.2.0-beta.10</PackageVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.10</FileVersion>
    <InformationalVersion>1.2.0-beta.10</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <DeskCanvasInstallerSource>$(MSBuildThisFileDirectory)..\..\installer\DeskCanvas.v37.Beta10.FinalValidation.SingleFile.iss</DeskCanvasInstallerSource>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v36\App\ApplicationVersion.V36Beta9.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v37\App\ApplicationVersion.V37Beta10.cs" Link="ApplicationVersion.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v36\Tests\V36Beta9ContractTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v37\Tests\V37Beta10ContractTests.cs" Link="V37Beta10ContractTests.cs" />
  </ItemGroup>
</Project>
