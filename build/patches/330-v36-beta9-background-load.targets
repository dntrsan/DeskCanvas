<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Version>1.2.0-beta.9</Version>
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix>beta.9</VersionSuffix>
    <PackageVersion>1.2.0-beta.9</PackageVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.9</FileVersion>
    <InformationalVersion>1.2.0-beta.9</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <DeskCanvasInstallerSource>$(MSBuildThisFileDirectory)..\..\installer\DeskCanvas.v36.Beta9.BackgroundLoad.SingleFile.iss</DeskCanvasInstallerSource>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.App'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v35\App\ApplicationVersion.V35Beta8.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v36\App\ApplicationVersion.V36Beta9.cs" Link="ApplicationVersion.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeskCanvas.Tests'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\overrides\v35\Tests\V35Beta8ContractTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\overrides\v36\Tests\V36Beta9ContractTests.cs" Link="V36Beta9ContractTests.cs" />
  </ItemGroup>
</Project>
