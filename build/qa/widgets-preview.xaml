<!--
    Design reference for the desktop widget cards. Hand-mirrors the token values in
    src\DeskCanvas.App\Windows\DesignSystem.cs so the look can be reviewed without a
    .NET SDK. This file is NOT compiled into the app and is not a substitute for
    running the real widgets; update it whenever Design changes.
-->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980"
        Height="560">
    <Border.Background>
        <!--  Stand-in wallpaper: widgets must stay legible over light and dark areas.  -->
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#3E4A63"/>
            <GradientStop Offset=".45" Color="#8E7F92"/>
            <GradientStop Offset="1" Color="#D8CFC4"/>
        </LinearGradientBrush>
    </Border.Background>

    <Border.Resources>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, Yu Gothic UI, Meiryo UI</FontFamily>
        <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Yu Gothic UI, Meiryo UI</FontFamily>

        <SolidColorBrush x:Key="Label" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Label2" Color="#99EBEBF5"/>
        <SolidColorBrush x:Key="Label3" Color="#5CEBEBF5"/>
        <SolidColorBrush x:Key="Hairline" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="Well" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#D11C1C1E"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="Foreground" Value="{StaticResource Label}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!--  Design.CardShadow / Design.CardRadius / Design.CardPadding  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,16,18,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="26"
                                      Opacity=".28"
                                      ShadowDepth="5"
                                      Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Border.Resources>

    <Grid Margin="34">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  ===== Clock: digital ===== -->
        <Border Style="{StaticResource Card}" Width="300" Height="152">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="21:47"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="52"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="09"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{StaticResource Label3}"
                               VerticalAlignment="Bottom"
                               Margin="8,0,0,9"
                               Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
                <TextBlock Text="8月20日"
                           FontSize="12"
                           Foreground="{StaticResource Label2}"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <!--  ===== Now playing ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Width="368" Height="216">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="88"
                            Height="88"
                            CornerRadius="13"
                            Margin="0,0,15,0"
                            Background="{StaticResource Well}"
                            BorderBrush="{StaticResource Hairline}"
                            BorderThickness="1">
                        <TextBlock Text="♪"
                                   FontSize="30"
                                   Foreground="{StaticResource Label3}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Spotify"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Label3}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="Weightless"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Marconi Union" FontSize="13" Foreground="{StaticResource Label2}"/>
                        <TextBlock Text="Ambient Works"
                                   FontSize="11"
                                   Foreground="{StaticResource Label3}"/>
                    </StackPanel>
                </Grid>

                <Grid Height="16" Margin="0,10,0,0">
                    <Border Height="3"
                            CornerRadius="1.5"
                            Background="#3DFFFFFF"
                            VerticalAlignment="Center"/>
                    <Border Width="196"
                            Height="3"
                            CornerRadius="1.5"
                            Background="#E0FFFFFF"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="1,-1,1,0">
                    <TextBlock Text="3:12"
                               FontSize="10"
                               Foreground="{StaticResource Label2}"
                               Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="−2:41"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource Label2}"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!--  Geometry strings mirror TransportGlyph in LiveItemContent.cs.  -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="16"
                            Margin="4,0"
                            Background="Transparent">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Fill="{StaticResource Label}"
                              Data="M 1,1 H 2.6 V 11 H 1 Z M 11,1 L 3.6,6 L 11,11 Z"/>
                    </Border>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Margin="12,0"
                            Background="#FFFFFF">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Fill="#1C1C1E"
                              Data="M 2,1 H 4.5 V 11 H 2 Z M 7.5,1 H 10 V 11 H 7.5 Z"/>
                    </Border>
                    <Border Width="32"
                            Height="32"
                            CornerRadius="16"
                            Margin="4,0"
                            Background="Transparent">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Fill="{StaticResource Label}"
                              Data="M 11,1 H 9.4 V 11 H 11 Z M 1,1 L 8.4,6 L 1,11 Z"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  ===== Clock: split ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Width="300" Height="180">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="60"
                            Height="54"
                            CornerRadius="14"
                            Background="{StaticResource Well}">
                        <TextBlock Text="21"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Border>
                    <TextBlock Text=":"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="26"
                               FontWeight="Light"
                               Foreground="{StaticResource Label3}"
                               Margin="7,3,7,0"
                               VerticalAlignment="Center"/>
                    <Border Width="60"
                            Height="54"
                            CornerRadius="14"
                            Background="{StaticResource Well}">
                        <TextBlock Text="47"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="09"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource Label3}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
                <TextBlock Text="8月20日"
                           FontSize="12"
                           Foreground="{StaticResource Label2}"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <!--  ===== System monitor ===== -->
        <Border Grid.Row="2"
                Grid.Column="2"
                Style="{StaticResource Card}"
                Width="368"
                Height="180">
            <StackPanel>
                <TextBlock Text="SYSTEM"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Label3}"
                           Margin="3,0,0,8"/>

                <Grid Margin="3,6,3,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" MinWidth="32"/>
                    <Grid Grid.Column="1" Margin="12,0,10,0">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="#24FFFFFF"
                                VerticalAlignment="Center"/>
                        <Border Width="96"
                                Height="4"
                                CornerRadius="2"
                                Background="#0A84FF"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="34 %"
                               FontSize="11"
                               MinWidth="46"
                               TextAlignment="Right"
                               Foreground="{StaticResource Label2}"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <Grid Margin="3,6,3,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" MinWidth="32"/>
                    <Grid Grid.Column="1" Margin="12,0,10,0">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="#24FFFFFF"
                                VerticalAlignment="Center"/>
                        <Border Width="171"
                                Height="4"
                                CornerRadius="2"
                                Background="#30D158"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="61 %"
                               FontSize="11"
                               MinWidth="46"
                               TextAlignment="Right"
                               Foreground="{StaticResource Label2}"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <Grid Margin="3,6,3,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU" FontSize="11" FontWeight="SemiBold" MinWidth="32"/>
                    <Grid Grid.Column="1" Margin="12,0,10,0">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="#24FFFFFF"
                                VerticalAlignment="Center"/>
                        <Border Width="42"
                                Height="4"
                                CornerRadius="2"
                                Background="#BF5AF2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="15 %"
                               FontSize="11"
                               MinWidth="46"
                               TextAlignment="Right"
                               Foreground="{StaticResource Label2}"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Height="26"
                            Margin="0,0,3,0"
                            CornerRadius="13"
                            Background="{StaticResource Well}">
                        <TextBlock Text="↓  4.2 MB/s"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#64D2FF"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Border>
                    <Border Grid.Column="1"
                            Height="26"
                            Margin="3,0,0,0"
                            CornerRadius="13"
                            Background="{StaticResource Well}">
                        <TextBlock Text="↑  0.3 MB/s"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF9F0A"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Border>
