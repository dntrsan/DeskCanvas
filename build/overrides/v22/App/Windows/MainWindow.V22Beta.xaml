
<Window x:Class="DeskCanvas.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:DeskCanvas.App"
        Title="{x:Static app:ApplicationVersion.WindowTitle}" Width="820" Height="560" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#11121A" Foreground="White"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="DeskCanvas" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Margin="12,1,0,0" Padding="8,3" CornerRadius="8" Background="#2E2A4C" VerticalAlignment="Center"><TextBlock Text="{x:Static app:ApplicationVersion.Display}" FontSize="11" FontWeight="SemiBold" Foreground="#C9C2FF"/></Border></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="＋ 画像 / GIFを追加" Click="Add_Click"/><Button Content="＋ 標準コンテンツ" Click="BuiltIn_Click"/>
                <Button x:Name="HideAllButton" Content="すべて隠す" Click="HideAll_Click"/>
                <Button x:Name="EditModeButton" MinWidth="170" Click="EditMode_Click" Background="#5146A5" Content="編集モードをON"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Margin="7,5,7,10" FontSize="15" FontWeight="SemiBold" Text="配置中の素材"/>
                <ListBox x:Name="ItemsList" Grid.Row="1" BorderThickness="0" Background="Transparent" Foreground="White" SelectionChanged="ItemsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding KindLabel}" Margin="0,3,0,0" FontSize="11" Foreground="#A8A9B7"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding IsLocked}" IsHitTestVisible="False" ToolTip="個別ロック" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            </Grid></Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22"><Grid>
                <TextBlock x:Name="EmptyMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Text="左の一覧から素材を選ぶか、&#x0a;ここへ画像 / GIFをドロップしてください。"/>
                <StackPanel x:Name="EditorPanel" Visibility="Collapsed"><TextBlock x:Name="SelectedName" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="0,22,0,7" Foreground="{StaticResource MutedBrush}" Text="透明度"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Slider x:Name="OpacitySlider" Minimum="5" Maximum="100" TickFrequency="5" ValueChanged="OpacitySlider_ValueChanged"/><TextBlock x:Name="OpacityValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    <TextBlock Margin="0,20,0,7" Foreground="{StaticResource MutedBrush}" Text="角度"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" TickFrequency="15" ValueChanged="RotationSlider_ValueChanged"/><TextBlock x:Name="RotationValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    <TextBlock Margin="0,20,0,7" Foreground="{StaticResource MutedBrush}" Text="装飾"/><ComboBox x:Name="DecorationCombo" SelectionChanged="DecorationCombo_SelectionChanged"><ComboBoxItem Content="None"/><ComboBoxItem Content="WhiteOutline"/><ComboBoxItem Content="OuterFrame"/></ComboBox>
                    <WrapPanel Margin="0,22,0,0"><CheckBox x:Name="ItemLockCheck" Margin="3,8,18,8" VerticalAlignment="Center" Click="ItemLockCheck_Click" Content="個別ロック"/><CheckBox x:Name="TemporaryHideCheck" Margin="3,8,18,8" VerticalAlignment="Center" Click="TemporaryHideCheck_Click" Content="一時的に隠す"/><CheckBox x:Name="FlipCheck" Margin="3,8,18,8" VerticalAlignment="Center" Click="FlipCheck_Click" Content="左右反転"/></WrapPanel>
                    <WrapPanel Margin="0,18,0,0"><Button Content="前面へ" Click="BringFront_Click"/><Button Content="背面へ" Click="SendBack_Click"/><Button Content="角度を戻す" Click="ResetRotation_Click"/><Button Content="削除" Foreground="#FFFF8D9A" Click="Delete_Click"/></WrapPanel>
                </StackPanel>
            </Grid></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="ロック中 — Ctrl + Alt + L で編集モードを切り替え"/><CheckBox x:Name="StartupCheck" Grid.Column="1" VerticalAlignment="Center" Click="StartupCheck_Click" Content="Windowsへのサインイン時に起動"/></Grid>
    </Grid>
</Window>
